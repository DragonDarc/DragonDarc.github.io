{
  "name": "mrlcom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && vite build && node scripts/finalize-pages.mjs",
    "preview": "vite preview",
    "update:data": "node --import ./scripts/ts-loader.mjs scripts/update-activities.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
